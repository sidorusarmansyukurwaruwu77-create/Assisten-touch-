<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TouchFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/tf_primary</item>
        <item name="colorOnPrimary">@color/tf_text_primary</item>
        <item name="colorPrimaryContainer">@color/tf_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/tf_text_primary</item>
        <item name="colorSecondary">@color/tf_secondary</item>
        <item name="colorOnSecondary">@color/tf_background</item>
        <item name="colorSecondaryContainer">@color/tf_secondary_soft</item>
        <item name="colorOnSecondaryContainer">@color/tf_text_primary</item>
        <item name="android:colorBackground">@color/tf_background</item>
        <item name="colorSurface">@color/tf_surface</item>
        <item name="colorOnSurface">@color/tf_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tf_text_secondary</item>
        <item name="colorOutline">@color/tf_stroke</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="TouchFlow.DisplayText" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/tf_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TouchFlow.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/tf_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TouchFlow.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tf_surface</item>
        <item name="strokeColor">@color/tf_stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="TouchFlow.BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/tf_primary_soft</item>
    </style>

</resources>
