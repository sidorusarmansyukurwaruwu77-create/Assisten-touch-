<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/menu_card_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Bar -->
        <LinearLayout
            android:id="@+id/menu_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btn_open_touchflow_app"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_badge"
                android:contentDescription="@string/app_name"
                android:padding="7dp"
                android:src="@drawable/ic_orb_ring" />

            <TextView
                android:id="@+id/tv_menu_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk"
                android:text="@string/app_name"
                android:textColor="@color/tf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_menu_minimax"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_badge"
                android:contentDescription="@string/cd_open_minimax"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_minimax" />

            <TextView
                android:id="@+id/btn_switch_quick_panel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_badge"
                android:drawablePadding="6dp"
                android:fontFamily="@font/inter"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/action_quick_panel"
                android:textColor="@color/tf_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close_menu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_badge"
                android:contentDescription="@string/cd_close_menu"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Dynamic Layout Host (Circular / Grid / Rectangle / Compact) -->
        <FrameLayout
            android:id="@+id/menu_actions_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- Dedicated Minimize & MiniMax Quick Strip -->
        <LinearLayout
            android:id="@+id/menu_minimax_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_menu_minimize_pill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_menu_minimize_pill"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_minimize" />

                <TextView
                    android:id="@+id/tv_menu_minimize_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/action_minimize"
                    android:textColor="@color/tf_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_menu_minimax_pill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_menu_minimax_pill"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_minimax" />

                <TextView
                    android:id="@+id/tv_menu_minimax_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/action_minimax"
                    android:textColor="@color/tf_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Favorite App Shortcuts Strip (shown when user has pinned apps) -->
        <LinearLayout
            android:id="@+id/menu_favorites_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_menu_favorites_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/quick_panel_favorites"
                android:textColor="@color/tf_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/menu_favorites_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
