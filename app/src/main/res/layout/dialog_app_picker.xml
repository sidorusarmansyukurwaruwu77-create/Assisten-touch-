<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tf_surface"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_grotesk"
        android:paddingHorizontal="18dp"
        android:text="@string/btn_add_shortcut"
        android:textColor="@color/tf_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_app_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_action_tile"
        android:fontFamily="@font/inter"
        android:hint="Search installed apps..."
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/tf_text_primary"
        android:textColorHint="@color/tf_text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_installed_apps"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="10dp" />

</LinearLayout>
