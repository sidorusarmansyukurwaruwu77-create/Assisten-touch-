<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minimax_dock_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="14dp"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/layout_minimax_dock_expanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_minimax_dock_app"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minimax" />

        <LinearLayout
            android:id="@+id/btn_minimax_dock_launch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="36dp"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_minimax_dock_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk"
                android:maxWidth="124dp"
                android:maxLines="1"
                android:text="@string/minimax_dock_ready"
                android:textColor="@color/tf_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_minimax_dock_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxWidth="132dp"
                android:maxLines="1"
                android:text="@string/minimax_dock_tap_mini"
                android:textColor="@color/tf_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_minimax_dock_open_full"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_badge"
            android:contentDescription="@string/cd_open_minimax"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_minimax" />

        <ImageButton
            android:id="@+id/btn_minimax_dock_minimize"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_badge"
            android:contentDescription="@string/cd_minimize_dock"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_minimize" />

        <ImageButton
            android:id="@+id/btn_minimax_dock_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_badge"
            android:contentDescription="@string/cd_close_menu"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_minimax_dock_minimized"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_minimax_dock_mini_app"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minimax" />

        <TextView
            android:id="@+id/tv_minimax_dock_mini_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk"
            android:maxWidth="108dp"
            android:maxLines="1"
            android:text="@string/minimax_dock_minimized_chip"
            android:textColor="@color/tf_text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_minimax_dock_expand"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/cd_minimize_dock"
            android:src="@drawable/ic_minimax" />
    </LinearLayout>

</FrameLayout>
